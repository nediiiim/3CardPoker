<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx ="http://javafx.com/fxml/1" 
			styleClass ="borderpane" 
			fx:controller = "ServerGameStateController" 
			prefWidth = "800" prefHeight = "600">
			
			<!-- Top Bar (Status label on the left, Stop button on the right) -->
			<top>
				<HBox alignment = "CENTER_LEFT" spacing = "20">
					<Label fx:id = "statusLabel" text = "Status: ON" />
					<Pane HBox.hgrow = "ALWAYS" />
					<Button fx:id = "stopButton" 
							text = "Turn Server Off"
							onAction = "#turnOffServer" />
				</HBox>
				
				<BorderPane.margin>
					<Insets top = "10" right = "10" bottom = "0" left = "10"/>
				</BorderPane.margin>
			</top>
			
			<!-- Middle Area (Static cards and ListView of server log -->
			<center>
				<VBox spacing = "15" alignment = "TOP_CENTER">
					<BorderPane.margin>
						<Insets top = "50" right = "0" bottom = "0" left = "0"/>
					</BorderPane.margin>
					<!-- Row of 3 cards -->
					<HBox spacing = "100" alignment = "CENTER">
						<!-- Number of Active Clients -->
						<VBox alignment = "CENTER">
							<Label text = "Active Clients" />
							<Label fx:id = "clientCountLabel" text = "0" />
						</VBox>
						
						<!-- Top winner -->
						<VBox alignment = "CENTER">
							<Label text = "Top Winner" />
							<Label fx:id = "highestWinnerLabel" text = "N/A" />
						</VBox>
						
						<!-- Top loser -->
						<VBox alignment = "CENTER">
							<Label text = "Top Loser" />
							<Label fx:id = "highestLoserLabel" text = "N/A" />
						</VBox>
					</HBox>
					
					<Pane VBox.vgrow = "ALWAYS" />
					
					<!-- Server Log ListView-->
					<Label text = "Server Log" />
					<ListView fx:id = "serverLog"
							  VBox.vgrow = "ALWAYS"
							  prefHeight = "300"
							  prefWidth = "500" />
				</VBox>
			</center>
</BorderPane>