<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx ="http://javafx.com/fxml/1" 
			styleClass ="borderpane" 
			fx:controller = "ResultsScreenController" 
			prefWidth = "800" prefHeight = "600">
			
	<center>
		<VBox spacing = "40" alignment = "TOP_CENTER">
			<padding>
					<Insets top = "50" right = "40" bottom = "50" left = "40" />
			</padding>
			<!-- Title -->
			<Label fx:id = "resultTitle" />
			
			<!-- Detailed Message -->
			<Label fx:id = "resultDetail" wrapText = "true" maxWidth = "650" alignment = "CENTER" />
			
			<!-- Winnings Section -->
			<VBox spacing = "15" alignment = "CENTER">
				<Label fx:id = "roundWinnings" />
				<Label fx:id = "totalWinnings" />
			</VBox>
			<!-- Buttons -->
			<HBox spacing = "20" alignment = "CENTER">
				<Button fx:id = "playAgainButton" text = "Play Again" onAction = "#playAgain" prefWidth = "250" prefHeight = "50" />
				<Button fx:id = "exitButton" text = "Exit" onAction = "#exitGame" prefWidth = "250" prefHeight = "50" />
			</HBox>
		</VBox>
	</center>
			
</BorderPane>